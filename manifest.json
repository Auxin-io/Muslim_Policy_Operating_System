{
  "manifest_version": 3,
  "name": "Muslim Policy Operating System",
  "short_name": "Muslim Policy OS",
  "version": "2.0.0",
  "description": "Automatically detects laws and bills on pages you visit and shows how they may affect Muslim communities across US states — Muslim Impact, Muslim Exposure, Possible Actions, and Key Deadlines.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Muslim Policy OS",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
